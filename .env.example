# ========================================
# Firebase Configuration
# ========================================

# Path to Firebase Admin SDK credentials JSON file (downloaded from Firebase Console)
FIREBASE_CREDENTIALS_PATH=firebase_key.json


# ========================================
# JWT Security Configuration
# ========================================

# Secret key for signing JWT tokens (CHANGE THIS in production!)
# Generate a secure key with: openssl rand -hex 32
SECRET_KEY=your_secure_secret_key_here_1234567890abcdef

# Algorithm for signing JWT tokens (recommended: HS256 or RS256)
ALGORITHM=HS256

# Token expiration time in minutes (e.g., 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Firebase Config
FIREBASE_API_KEY=tankmonitor_firebase_api_key
